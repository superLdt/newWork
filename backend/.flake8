[flake8]
# 最大行长度
max-line-length = 88

# 忽略的错误类型
ignore = E203, E266, E501, W503

# 排除的目录和文件
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    migrations

# 每个文件的最大复杂度
max-complexity = 10

# 导入检查
import-order-style = google

# 统计输出
statistics = True

# 显示源代码
show-source = True